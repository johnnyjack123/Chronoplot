# ---------------------------------------------------------------------------
# Chronoplot server configuration
# Copy this file to `.env` (in the repo root) and adjust. Never commit `.env`.
#
# Docker Compose reads the same file, so this is the single place to configure
# the instance whether it runs natively or in a container. The one exception is
# DATABASE_URL: inside a container it has to point at the volume, so compose
# sets that itself and ignores the value below.
# ---------------------------------------------------------------------------

# HTTP port the API server listens on.
PORT=5174

# "development" enables verbose logging and relaxes the cookie `Secure` flag so
# the app works over plain http://localhost. Use "production" behind HTTPS.
NODE_ENV=development

# Which database driver to use: "sqlite" or "postgres".
# SQLite is the zero-setup default; switching to Postgres later needs no code
# changes - only DB_DRIVER and DATABASE_URL change.
DB_DRIVER=sqlite

# For DB_DRIVER=sqlite: a file path (relative paths resolve from the repo root).
# For DB_DRIVER=postgres: a connection string, e.g.
#   postgres://user:password@localhost:5432/chronoplot
DATABASE_URL=./data/chronoplot.sqlite

# Secret used to sign CSRF tokens. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to start in production if this is missing or too short.
SESSION_SECRET=change-me-to-a-long-random-string-before-deploying

# Origin the browser app is served from. Used for CORS and cookie scoping.
# In development Vite runs on 5173 and proxies /api to this server.
APP_ORIGIN=http://localhost:5173

# Set to "false" to close registration once your team has signed up.
ALLOW_REGISTRATION=true
